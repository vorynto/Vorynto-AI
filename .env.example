# ═══════════════════════════════════════════════════════════════
#  Vorynto AI — Environment Variables
# ═══════════════════════════════════════════════════════════════
#  Copy this file to .env.local and fill in the values.
#  Only platform-level keys belong here.
#  Tenant API keys (OpenAI, WhatsApp, Twilio, SMTP, Meta Ads)
#  are managed per-tenant in Settings → API Keys & Integrations
#  and stored in the tenant_api_keys database table.
# ═══════════════════════════════════════════════════════════════

# Supabase (platform database & auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vorynto AI

# Stripe — Platform subscription billing only
# Tenants pay Vorynto AI here; API usage is billed by their own providers.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# WhatsApp webhook signature verification (platform-level)
# The actual WhatsApp Access Token, Phone Number ID, WABA ID are per-tenant
# and stored in the tenant_api_keys table — NOT here.
WHATSAPP_API_VERSION=v18.0

# ─────────────────────────────────────────────────────────────────
#  TENANT-MANAGED KEYS (do NOT add these here)
#  The following are configured per-tenant in the dashboard:
#    • OpenAI API Key
#    • WhatsApp Business API credentials (Access Token, Phone Number ID, WABA ID, Verify Token)
#    • Twilio Account SID / Auth Token / From Number
#    • SMTP credentials (Host, Port, User, Password, From Email)
#    • Meta Ads App ID / App Secret / Access Token / Ad Account ID
#  These are stored encrypted in the tenant_api_keys table.
# ─────────────────────────────────────────────────────────────────
